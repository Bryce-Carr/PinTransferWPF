<Window x:Class="PinTransferWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mvvm="using:CommunityToolkit.Mvvm.Input"
        xmlns:local="clr-namespace:PinTransferWPF"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="Pin Transfer v2.0"
        Height="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}, Converter={local:RatioConverter}, ConverterParameter='0.7' }" 
        Width="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}, Converter={local:RatioConverter}, ConverterParameter='0.7' }" 
        WindowStartupLocation="CenterScreen"
        MinWidth="800"
        MinHeight="300"
        Style="{StaticResource RoundedWindowStyle}"
        AllowsTransparency="True"
        Background="Transparent"
    >

    <Grid x:Name="MainGrid" Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.ColumnSpan="5" Fill="{StaticResource PrimaryBrush}" MouseDown="TitleBar_MouseDown"/>
        <DockPanel Grid.Column="8" HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           LastChildFill="True">

            <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Stretch"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right">

                <Button x:Name="MinimizeButton"
                    KeyboardNavigation.IsTabStop="False"
                    Command="{Binding MinimizeWindowCommand}"
                    Style="{StaticResource TitleBarButton}"
                    Template="{StaticResource MinimizeButtonControlTemplate}"/>

                <Button x:Name="MaximizeButton" Command="{Binding MaximizeWindowCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                            <Setter Property="Template" Value="{StaticResource MaximizeButtonControlTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                    <Setter Property="Template" Value="{StaticResource RestoreButtonControlTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="CloseButton"
                    KeyboardNavigation.IsTabStop="False"
                    Command="{Binding CloseWindowCommand}"
                    Style="{DynamicResource TitleBarButton}"
                    Template="{DynamicResource CloseButtonControlTemplate}"/>

            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left"
                        HorizontalAlignment="Left">
                <Image Source="Assets/Mountain.ico" Height="30" Width="30"/>
                <ComboBox x:Name="fileComboBox" 
                        Template="{StaticResource TitleBarComboBoxTemplate}"
                        Tag="  File  "
                        local:ComboBoxExtensions.ButtonFontFamily="Deja Vu"
                        local:ComboBoxExtensions.ButtonFontSize="24"
                        ItemsSource="{Binding FileOptions}"
                        SelectedItem="{Binding SelectedFileOption}">
                </ComboBox>
                <ComboBox x:Name="toolsComboBox" 
                        Template="{StaticResource TitleBarComboBoxTemplate}"
                        Tag="  Tools  "
                        local:ComboBoxExtensions.ButtonFontFamily="Deja Vu"
                        local:ComboBoxExtensions.ButtonFontSize="24"
                        ItemsSource="{Binding ToolOptions}"
                        SelectedItem="{Binding SelectedToolOption}">
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <Viewbox x:Name="StackerGridViewbox" Grid.Column="0" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid x:Name="StackerGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10" Background="{StaticResource SecondaryBackgroundBrush}">
                <!-- Stacks will be added here programmatically -->
            </Grid>
        </Viewbox>

        <Grid Grid.Column="1" Grid.Row="3" Margin="0,10,10,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>   
            <ListView ItemsSource="{Binding SourcePlates}"
              x:Name="SourcePlateListView"
              SelectedItem="{Binding SelectedSourcePlate, Mode=TwoWay}"
              Grid.Column="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ID}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView ItemsSource="{Binding DestinationPlates}" 
              x:Name="DestinationPlateListView"
              SelectedItem="{Binding SelectedDestinationPlate, Mode=TwoWay}"
              Grid.Column="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ID}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="1" Margin="10,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" >
                    <Label Content="Sources:" VerticalAlignment="Stretch" />
                    <TextBox Text="{Binding SourcesToAdd}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" >
                    <Label Content="Replicates" VerticalAlignment="Stretch" />
                    <TextBox Text="{Binding ReplicatesOfSourcesToAdd}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" >
                    <Label Content="Volume" VerticalAlignment="Stretch" />
                    <TextBox Text="{Binding VolumeOfSourcesToAdd}" HorizontalAlignment="Stretch" MinWidth="30"/>
                </StackPanel>
                <Button Content="AddPlates" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Stretch"
                        Command="{Binding CreatePlatesCommand}"
                        />
            </Grid>
            <!-- New UI elements for creating a run -->
            <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" >
                    <Label Content="Run ID:" VerticalAlignment="Stretch" />
                    <TextBox Text="{Binding RunID}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" >
                    <Label Content="Screen Number:" VerticalAlignment="Stretch" />
                    <TextBox Text="{Binding ScreenNumber}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" >
                    <Label Content="User Name:" VerticalAlignment="Stretch" />
                    <TextBox Text="{Binding UserName}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" >
                    <Label Content="Current Script Line:" VerticalAlignment="Stretch" />
                    <TextBox Text="{Binding CurrentScriptLine}"/>
                </StackPanel>
                <Button Grid.Row="4" x:Name="btnCreateRun" Margin="5" Padding="5" Content="Create Run"
            Command="{Binding CreateRunCommand}"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="RunCommandsButton" Content="Run Commands" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" VerticalAlignment="Stretch"
                    Command="{Binding StartRunCommand}"
                    IsEnabled="{Binding CanRunCommands}"/>
                <Button x:Name="CancelButton" Content="Pause" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" VerticalAlignment="Stretch"
                    Command="{Binding CancelRunCommand}"
                    IsEnabled="{Binding CanCancel}"/>
                <Button Content="ResumeButton" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0" VerticalAlignment="Stretch"
                    Command="{Binding ResumeRunCommand}"/>
            </Grid>
        </Grid>
        
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" Name="StatusScrollViewer" Grid.Row="1" Grid.Column="6" VerticalAlignment="Stretch">
            <TextBlock x:Name="StatusTextBlock" 
               TextWrapping="Wrap" 
               VerticalAlignment="Stretch" 
               HorizontalAlignment="Left"
               Text="{Binding StatusText}"/>
        </ScrollViewer>
        
    </Grid>
</Window>